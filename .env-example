POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456
POSTGRES_DB=keyrunes
POSTGRES_PORT=5432
DATABASE_URL="postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}"
JWT_SECRET=your-super-secret-jwt-key-change-in-production
LOG_LEVEL=info
SMTP_USERNAME=noreply@example.com
SMTP_PASSWORD=your_smtp_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
FROM_EMAIL=noreply@example.com
FROM_NAME=KeyRunes

# Google reCAPTCHA (optional). Set BOTH or neither; the server fails to start
# if only one is configured. Leave unset to disable captcha verification.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Password reset token TTL in hours (default 1, clamped 1..=24). Optional.
PASSWORD_RESET_TOKEN_TTL_HOURS=1
# Dev only: log the full reset link (with token) when email service is absent.
# Keep false in production.
KEYRUNES_DEV_RESET_IN_LOG=false
